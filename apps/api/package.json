{
  "name": "@synvaro/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsc-watch --onSuccess \"node --env-file-if-exists=../../.env dist/main.js\"",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.4",
    "@synvaro/contracts": "workspace:*",
    "@synvaro/database": "workspace:*",
    "argon2": "0.45.1",
    "busboy": "1.6.0",
    "cookie": "^1.0.2",
    "express": "^5.2.1",
    "openai": "7.43.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/busboy": "1.5.5",
    "@types/express": "^5.0.3",
    "tsc-watch": "7.2.1"
  }
}

// Current development scope accepted by owner in SYN-002B.
generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(254)
  passwordHash String
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
  sessions     Session[]
  organization Organization?
  aiPreference AiPreference?
  aiGenerations AiGeneration[]
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @db.Char(64)
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
}

model Organization {
  id          String   @id @default(uuid()) @db.Uuid
  ownerUserId String   @unique @db.Uuid
  owner       User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  name        String   @db.VarChar(120)
  slug        String   @unique @db.VarChar(80)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  brands      Brand[]
}

model Brand {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String       @db.VarChar(120)
  slug           String       @db.VarChar(80)
  description    String?      @db.VarChar(2000)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  profile        BrandProfile?
  contents       Content[]
  mediaAssets    MediaAsset[]

  @@unique([organizationId, slug])
}

model BrandProfile {
  id                String   @id @default(uuid()) @db.Uuid
  brandId           String   @unique @db.Uuid
  brand             Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  description       String   @default("") @db.Text
  targetAudience    String   @default("") @db.Text
  toneOfVoice       String   @default("") @db.Text
  defaultLanguage   String?  @db.VarChar(100)
  contentGuidelines String   @default("") @db.Text
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)
}

enum ContentStatus {
  DRAFT
}

model Content {
  id        String        @id @default(uuid()) @db.Uuid
  brandId   String        @db.Uuid
  brand     Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  title     String        @db.VarChar(200)
  body      String        @default("") @db.Text
  status    ContentStatus @default(DRAFT)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)

  media ContentMedia[]
  aiGenerations AiGeneration[]

  @@index([brandId, updatedAt(sort: Desc), id(sort: Desc)])
}

enum MediaOrigin {
  AI_GENERATED
  AI_EDITED
  AI_VOICE
  AI_VIDEO
  UPLOADED
}

model MediaAsset {
  id               String      @id @default(uuid()) @db.Uuid
  brandId          String      @db.Uuid
  brand            Brand       @relation(fields: [brandId], references: [id], onDelete: Restrict)
  originalFilename String      @db.VarChar(255)
  storageKey       String      @unique @db.Uuid
  mimeType         String      @db.VarChar(40)
  sizeBytes        Int
  width            Int?
  height           Int?
  durationMs       Int?
  origin           MediaOrigin @default(UPLOADED)
  createdAt        DateTime    @default(now()) @db.Timestamptz(3)

  generation AiGeneration?
  sourceForGenerations AiGeneration[] @relation("ImageEditSource")
  contents ContentMedia[]

  @@index([brandId, createdAt(sort: Desc), id(sort: Desc)])
}

model ContentMedia {
  contentId String @db.Uuid
  mediaAssetId String @db.Uuid
  position Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  asset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@id([contentId, mediaAssetId])
  @@index([contentId, position, mediaAssetId])
  @@index([mediaAssetId])
}

model AiPreference {
  speechEnabled Boolean @default(false)
  videoEnabled Boolean @default(false)
  imageEnabled Boolean @default(false)
  imageModel String @default("gpt-image-2.5-flare") @db.VarChar(80)
  imageSize String @default("1024x1024") @db.VarChar(20)
  imageQuality String @default("low") @db.VarChar(20)
  imageAspectRatio String @default("1:1") @db.VarChar(10)
  userId String @id @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled Boolean @default(false)
  model String @default("gpt-6-luna") @db.VarChar(80)
  maxOutputTokens Int @default(512)
  monthlyBudgetMicros BigInt?
  confirmPaid Boolean @default(true)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

enum AiGenerationStatus {
  COUNTING
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  BLOCKED
}

enum AiGenerationKind {
  TEXT
  IMAGE
  SPEECH
  VIDEO
}

model AiGeneration {
  videoAspectRatio String? @db.VarChar(10)
  videoResolution String? @db.VarChar(10)
  videoDuration String? @db.VarChar(10)
  outputVideoTokens Int?
  videoHasAudio Boolean?
  voiceId String? @db.VarChar(80)
  narrationCharacters Int?
  providerCharacterCost Int?
  reconciliation AiGenerationReconciliation?
  kind AiGenerationKind @default(TEXT)
  provider String @default("openai") @db.VarChar(40)
  imageSize String? @db.VarChar(20)
  imageQuality String? @db.VarChar(20)
  imageAspectRatio String? @db.VarChar(10)
  sourceMediaAssetId String? @db.Uuid
  sourceMediaAsset MediaAsset? @relation("ImageEditSource", fields: [sourceMediaAssetId], references: [id], onDelete: Restrict)
  providerGenerationId String? @db.VarChar(160)
  inputImageTokens Int?
  previewKey String? @unique @db.Uuid
  previewExpiresAt DateTime? @db.Timestamptz(3)
  mediaAssetId String? @unique @db.Uuid
  mediaAsset MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  contentId String @db.Uuid
  content Content @relation(fields: [contentId], references: [id], onDelete: Restrict)
  requestId String @db.Uuid
  model String @db.VarChar(80)
  maxOutputTokens Int
  status AiGenerationStatus
  inputTokens Int?
  outputTokens Int?
  estimatedCostMicros Int?
  budgetChargeMicros Int @default(0)
  costUncertain Boolean @default(false)
  errorCode String? @db.VarChar(40)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)

  @@unique([userId, requestId])
  @@index([userId, createdAt])
  @@index([contentId])
  @@index([previewExpiresAt])
  @@index([sourceMediaAssetId])
}

// Operator-only audit record. Provider usage evidence is required before changing
// an uncertain reservation; no application endpoint exposes this operation.
model AiGenerationReconciliation {
  id String @id @default(uuid()) @db.Uuid
  generationId String @unique @db.Uuid
  generation AiGeneration @relation(fields: [generationId], references: [id], onDelete: Restrict)
  previousBudgetChargeMicros Int
  resolvedBudgetChargeMicros Int
  evidenceReference String @db.VarChar(500)
  operator String @db.VarChar(120)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

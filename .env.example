# Copy to .env at repository root. Never commit real credentials.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
# Dedicated local PostgreSQL database; use your own local password.
DATABASE_URL=postgresql://synvaro:local_only@localhost:5432/synvaro?schema=public
# Exact public browser origin, no trailing slash. Production requires HTTPS.
WEB_ORIGIN=http://127.0.0.1:3000
# Server-only Next.js setting. NestJS should bind loopback on a single-host setup.
API_INTERNAL_URL=http://127.0.0.1:3001
# Required for media uploads and AI image previews. Explicit absolute PRIVATE directory
# outside the repository/public web roots; create with mode 0700. No default.
MEDIA_STORAGE_ROOT=
# ffprobe executable from a maintained FFmpeg install (PATH lookup by default).
FFPROBE_PATH=ffprobe
# Optional, server-side NestJS only; shared by text and image generation.
# Empty disables AI gracefully. Image spending rules: docs/development.md.
# Obtain your own OpenAI API key; never use NEXT_PUBLIC_ or commit a real key.
OPENAI_API_KEY=
# Optional server-only key for Gemini text; selected spending limits block Gemini.
# Do not prefix provider keys with NEXT_PUBLIC_.
GOOGLE_API_KEY=
# Google Nano Banana 2.1 has no free-tier API access. Set true only after
# confirming paid-tier access for this exact Google project; no paid probe runs.
GOOGLE_IMAGE_PAID_TIER_CONFIRMED=false
# Planned speech integration only; setting this does not enable ElevenLabs.
ELEVENLABS_API_KEY=

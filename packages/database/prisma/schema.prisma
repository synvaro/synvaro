// Current development scope accepted by owner in SYN-002B.
generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(254)
  passwordHash String
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
  sessions     Session[]
  organization Organization?
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @db.Char(64)
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
}

model Organization {
  id          String   @id @default(uuid()) @db.Uuid
  ownerUserId String   @unique @db.Uuid
  owner       User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  name        String   @db.VarChar(120)
  slug        String   @unique @db.VarChar(80)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  brands      Brand[]
}

model Brand {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String       @db.VarChar(120)
  slug           String       @db.VarChar(80)
  description    String?      @db.VarChar(2000)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  profile        BrandProfile?
  contents       Content[]
  mediaAssets    MediaAsset[]

  @@unique([organizationId, slug])
}

model BrandProfile {
  id                String   @id @default(uuid()) @db.Uuid
  brandId           String   @unique @db.Uuid
  brand             Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  description       String   @default("") @db.Text
  targetAudience    String   @default("") @db.Text
  toneOfVoice       String   @default("") @db.Text
  defaultLanguage   String?  @db.VarChar(100)
  contentGuidelines String   @default("") @db.Text
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)
}

enum ContentStatus {
  DRAFT
}

model Content {
  id        String        @id @default(uuid()) @db.Uuid
  brandId   String        @db.Uuid
  brand     Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  title     String        @db.VarChar(200)
  body      String        @default("") @db.Text
  status    ContentStatus @default(DRAFT)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)

  media ContentMedia[]

  @@index([brandId, updatedAt(sort: Desc), id(sort: Desc)])
}

enum MediaOrigin {
  UPLOADED
}

model MediaAsset {
  id               String      @id @default(uuid()) @db.Uuid
  brandId          String      @db.Uuid
  brand            Brand       @relation(fields: [brandId], references: [id], onDelete: Restrict)
  originalFilename String      @db.VarChar(255)
  storageKey       String      @unique @db.Uuid
  mimeType         String      @db.VarChar(40)
  sizeBytes        Int
  width            Int?
  height           Int?
  durationMs       Int?
  origin           MediaOrigin @default(UPLOADED)
  createdAt        DateTime    @default(now()) @db.Timestamptz(3)

  contents ContentMedia[]

  @@index([brandId, createdAt(sort: Desc), id(sort: Desc)])
}

model ContentMedia {
  contentId String @db.Uuid
  mediaAssetId String @db.Uuid
  position Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  asset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@id([contentId, mediaAssetId])
  @@index([contentId, position, mediaAssetId])
  @@index([mediaAssetId])
}

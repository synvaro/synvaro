# Copy to .env at repository root. Never commit real credentials.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
# Dedicated local PostgreSQL database; use your own local password.
DATABASE_URL=postgresql://synvaro:local_only@localhost:5432/synvaro?schema=public
# Exact public browser origin, no trailing slash. Production requires HTTPS.
WEB_ORIGIN=http://127.0.0.1:3000
# Server-only Next.js setting. NestJS should bind loopback on a single-host setup.
API_INTERNAL_URL=http://127.0.0.1:3001
